{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "app-commands",
    "opener:default",
    {
      "identifier": "opener:allow-open-path",
      "allow": [
        { "path": "http://**" },
        { "path": "https://**" }
      ]
    },
    "dialog:default",
    "dialog:allow-confirm",
    "dialog:allow-ask",
    "dialog:allow-message"
  ]
}
