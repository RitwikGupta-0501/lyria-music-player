pkgname=lyria-bin
_pkgname=lyria
pkgver=0.2.1
pkgrel=1
pkgdesc="Minimal, algorithmically-driven local audio player"
arch=('x86_64')
url="https://github.com/RitwikGupta-0501/lyria-music-player"
license=('GPL-3.0-only')
depends=(
    'webkit2gtk-4.1'
    'gtk3'
    'alsa-lib'
    'libappindicator-gtk3'
    'hicolor-icon-theme'
)
provides=("${_pkgname}")
conflicts=("${_pkgname}")
source=("https://github.com/RitwikGupta-0501/lyria-music-player/releases/download/v${pkgver}/Lyria_${pkgver}_amd64.deb")
sha256sums=('SKIP')

package() {
    bsdtar -xOf "${srcdir}/Lyria_${pkgver}_amd64.deb" data.tar.gz | bsdtar -x -C "${pkgdir}"
}
